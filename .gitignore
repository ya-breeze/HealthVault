backend/bin/
*.db
*.db-shm
*.db-wal
node_modules/
frontend/.next/
frontend/out/
.env

# Playwright run artifacts. e2e/.gitignore already covers e2e/test-results/,
# but Playwright writes them relative to the cwd it was started from, so a run
# launched from the repository root lands here instead.
test-results/
playwright-report/

# ralphex agent state
.ralphex/

# Android build output and local SDK/toolchain config — local.properties
# holds a machine-specific sdk.dir path and is never checked in.
android/local.properties
android/.gradle/
android/app/build/
android/build/
android/*.hprof
android/captures/

